# Sanity (public — safe to expose in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-22

# Sanity (server-only — Viewer token, never expose to the browser)
SANITY_API_READ_TOKEN=

# Clerk (public)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk (server-only)
CLERK_SECRET_KEY=

# Cache revalidation (server-only — set in Sanity webhook as a query param)
SANITY_REVALIDATE_SECRET=

# Search — Sanity Context MCP (server-only)
# Format: https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/<dataset>/vertex-search
SANITY_CONTEXT_MCP_URL=

# Search — LLM provider (server-only)
# Which provider generates search results: "openai" (default) or "anthropic".
SEARCH_PROVIDER=openai
# Provider API keys — set the one matching SEARCH_PROVIDER (SDKs read these from env).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the model. Provider-specific — leave blank for the provider default
# (openai: gpt-4o-mini, anthropic: claude-haiku-4-5).
SEARCH_MODEL=
